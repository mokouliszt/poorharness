# Pinned inputs for the on-device runtime (PRoot + Ubuntu rootfs + agent binaries).
# Every download is verified against the checksum below before it is used.
# Bump a version here, update its checksum, and rebuild; nothing else hardcodes them.
# Why each input was chosen: docs/adr/ (proot-build, ubuntu-image, engine-installs).
# How to bump one: docs/maintenance.md.

# --- PRoot (built from source with the Android NDK) -------------------------
PROOT_REPO=https://github.com/termux/proot
PROOT_TAG=v5.1.107.78
PROOT_COMMIT=a7147b50d708567dbf884d21e0f0c8698bba0d10
TALLOC_VERSION=2.4.3
TALLOC_URL=https://www.samba.org/ftp/talloc/talloc-2.4.3.tar.gz
TALLOC_SHA256=dc46c40b9f46bb34dd97fe41f548b0e8b247b77a918576733c528e83abd854dd
# Lowest API level the runner must start on (matches minSdk in android/app).
ANDROID_API=26

# --- Ubuntu userland --------------------------------------------------------
UBUNTU_BASE_URL=https://cdimage.ubuntu.com/ubuntu-base/releases/24.04/release/ubuntu-base-24.04.5-base-arm64.tar.gz
UBUNTU_BASE_SHA256=a91d5a93010193712d346d761372b7c9db6dfcf093893161c64ca107f05914f2
# Packages installed into the rootfs at build time (space separated).
UBUNTU_PACKAGES="ca-certificates curl git ripgrep less procps unzip zip xz-utils jq file python3 openssh-client"

# --- Agent binaries (initial versions; the app can update them later) --------
OPENCODE_VERSION=1.19.0
OPENCODE_TARBALL=https://registry.npmjs.org/opencode-linux-arm64/-/opencode-linux-arm64-1.19.0.tgz
OPENCODE_INTEGRITY=sha512-XD1qcVN4jEiaYHqtx40p8cEPJxBc1mcB99ksgQ81akZsGGwcNFyG6GH857jVEplbGgdzWiWxDCrSii56sHjmRQ==
# Installed by opencode on the device on first start (not bundled).
TENSORLAKE_PLUGIN_VERSION=0.3.1
